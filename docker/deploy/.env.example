# Copy to .env and fill in real values:  cp .env.example .env
#
# Keep .env out of version control. It holds your secrets.

# The public domain that points at this server (DNS A record -> server IP).
PAPERCLIP_DOMAIN=paperclip.example.com

# Email used by Let's Encrypt for certificate registration / expiry notices.
ACME_EMAIL=you@example.com

# Secret used to sign auth sessions. Generate once and keep stable:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# PostgreSQL password for the bundled database. Generate once:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: AI provider keys so local adapters (Claude/Codex) can run.
# You can also set these later per-company in the UI under Secrets.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
